# Your YouCam API key: https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# API server. Use https://yce-api-01.makeupar.com only if your account is on the India site.
YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com

# Safety cap: a run refuses to start if its estimated cost is above this.
MAX_UNITS_PER_RUN=20

# Clothes endpoint: cloth-v3 (documented at 2 units) or cloth-v4 (adds "outer"; cost not documented).
CLOTH_ENDPOINT=cloth-v3

# garment_category for checks 2 and 3: upper_body | lower_body | full_body | outer (v4 only)
WARDROBE_CATEGORY=upper_body
SHOP_ITEM_CATEGORY=full_body

# Optional overrides
# AI_GARMENT_PROMPT=
# HAIR_TEMPLATE_ID=
# YOUCAM_POLL_INTERVAL_MS=5000
# YOUCAM_POLL_TIMEOUT_MS=300000
