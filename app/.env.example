# Copy to .env (git-ignored). All of these are read in src/lib/server/config.ts only.

# --- Anthropic (the Godmother agent) ---
# Without a key, live sessions reply that keys are missing; demo mode still works.
ANTHROPIC_API_KEY=
# Main model for the agent and web research. It must support the server-side refusal fallback.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cheaper model for per-photo checks.
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# How hard the agent thinks per step: low, medium or high.
ANTHROPIC_EFFORT=medium

# --- YouCam (virtual try-on, makeup, hair, accessories) ---
YOUCAM_API_KEY=
# API origin (no trailing slash).
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
# Which try-on endpoint to use for outfits.
CLOTH_ENDPOINT=cloth-v4
# How chained renders pass the previous result on: 'reupload' (download + re-upload, safest) or 'url'.
YOUCAM_CHAIN_MODE=reupload
# Task polling.
YOUCAM_POLL_INTERVAL_MS=3000
YOUCAM_POLL_TIMEOUT_MS=300000

# --- Limits ---
# Max YouCam units one session may spend before tasks are refused.
UNIT_CAP_PER_SESSION=60

# --- Storage ---
# The working copy of sessions and images (default: ./data relative to the working directory).
DATA_DIR=./data

# --- Cloud saving (optional) ---
# Live sessions and images copy here in the background. Local disk keeps working if these are down.
# Postgres URL. On Supabase use the Session pooler string (IPv4) and keep sslmode=require.
DATABASE_URL=
# Optional: the server's CA certificate, to verify it as well as encrypt.
DATABASE_CA_CERT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Accounts (optional, needs DATABASE_URL) ---
# Signs login cookies: at least 32 random characters. Changing it signs everyone out.
AUTH_SECRET=
# YouCam units: a guest's one grant for good, and what a signed-in user gets and can re-claim daily.
GUEST_UNITS=50
USER_UNITS=60
# SHA-256 of the secret header Cloudflare adds. When set, /api only answers requests carrying it.
EDGE_SECRET_HASH=
# Password reset emails, sent through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# The site's public address, used in reset links. Set this in production.
APP_URL=

# --- Production server (adapter-node, read by `node build`) ---
# `pnpm start` loads this .env file with Node's --env-file-if-exists, so these work here too.
# Uploads are up to 10 MB but adapter-node rejects request bodies over 512K by default.
BODY_SIZE_LIMIT=12M
# adapter-node assumes https and Origin-checks multipart uploads (CSRF). Behind a TLS proxy set
# PROTOCOL_HEADER=x-forwarded-proto and HOST_HEADER=x-forwarded-host. For plain-http runs, list the
# origins in TRUSTED_ORIGINS at BUILD time (default: http://localhost:3000,http://localhost:4173).
# TRUSTED_ORIGINS=http://localhost:3000
PORT=3000
