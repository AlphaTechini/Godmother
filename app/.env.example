# Copy to .env (git-ignored). All of these are read in src/lib/server/config.ts only.

# --- OpenAI (the Godmother agent) ---
# Without a key, live sessions reply that keys are missing; demo mode still works.
OPENAI_API_KEY=
# Main reasoning model for the agent.
OPENAI_MODEL=gpt-5.1
# Cheaper model for small jobs (classification, extraction).
OPENAI_FAST_MODEL=gpt-5.1-mini

# --- YouCam (virtual try-on, makeup, hair, accessories) ---
YOUCAM_API_KEY=
# API origin (no trailing slash).
YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com
# Which try-on endpoint to use for outfits.
CLOTH_ENDPOINT=cloth-v3
# How chained renders pass the previous result on: 'reupload' (download + re-upload, safest) or 'url'.
YOUCAM_CHAIN_MODE=reupload
# Task polling.
YOUCAM_POLL_INTERVAL_MS=3000
YOUCAM_POLL_TIMEOUT_MS=300000

# --- Limits ---
# Max YouCam units one session may spend before tasks are refused.
UNIT_CAP_PER_SESSION=60

# --- Storage ---
# Where sessions and assets live (default: ./data relative to the working directory).
DATA_DIR=./data

# --- Production server (adapter-node, read by `node build`) ---
# `pnpm start` loads this .env file with Node's --env-file-if-exists, so these work here too.
# Uploads are up to 10 MB but adapter-node rejects request bodies over 512K by default.
BODY_SIZE_LIMIT=12M
# adapter-node assumes https and Origin-checks multipart uploads (CSRF). Set ORIGIN to the public URL,
# or behind a TLS proxy set PROTOCOL_HEADER=x-forwarded-proto and HOST_HEADER=x-forwarded-host instead.
ORIGIN=http://localhost:3000
PORT=3000
